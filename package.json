{
  "name": "wardrobe",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.2.0",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm --filter \"./packages/**\" run build && pnpm -r --if-present run typecheck",
    "lint": "pnpm -r --if-present run lint",
    "test": "pnpm --filter \"./packages/**\" run build && pnpm -r --if-present run test",
    "dev": "pnpm -r --if-present run dev"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "^22.10.0",
    "eslint": "9.39.5",
    "typescript": "^5.7.0",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  }
}
